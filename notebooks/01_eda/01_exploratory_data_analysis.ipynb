 "cells": [
  {"cell_type":"markdown","metadata":{},"source":["# 🔍 Notebook 1 – Exploratory Data Analysis\n","**RetailPulse | Zidio Development | Abhishek Kumar Prajapati**\n\n","UCI Online Retail II Dataset – 805K+ Transactions\n\n","**Objectives:**\n","- Understand dataset structure and quality\n","- Identify revenue patterns, seasonality, top products\n","- Build intuition for feature engineering\n"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["import pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport plotly.express as px\nimport plotly.graph_objects as go\nimport warnings\nwarnings.filterwarnings('ignore')\n\nplt.style.use('dark_background')\nsns.set_palette('husl')\n\nprint('Libraries loaded ✅')"]},
  {"cell_type":"markdown","metadata":{},"source":["## 1. Load & Inspect Data"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["import sys\nsys.path.insert(0, '../..')\nfrom src.ingestion.etl import run_etl\n\ndf, quality = run_etl(config_path='../../configs/config.yaml')\nprint(f'Shape: {df.shape}')\ndf.head()"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["print('=== Data Quality Report ===')\nfor k,v in quality.items():\n    if k != 'missing_values':\n        print(f'  {k:25s}: {v}')"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["df.info()\nprint(f'\\nMissing values:\\n{df.isnull().sum()}']},
  {"cell_type":"markdown","metadata":{},"source":["## 2. Revenue Distribution"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n\n# Revenue per transaction (capped at 99th percentile)\ncap = df['TotalPrice'].quantile(0.99)\naxes[0].hist(df[df['TotalPrice']<=cap]['TotalPrice'], bins=60, color='#3b82f6', edgecolor='none', alpha=0.8)\naxes[0].set_title('Revenue Per Transaction', fontsize=14)\naxes[0].set_xlabel('Revenue (£)')\naxes[0].set_ylabel('Count')\n\n# Quantity distribution\nqty_cap = df['Quantity'].quantile(0.99)\naxes[1].hist(df[df['Quantity']<=qty_cap]['Quantity'], bins=40, color='#10b981', edgecolor='none', alpha=0.8)\naxes[1].set_title('Order Quantity Distribution', fontsize=14)\naxes[1].set_xlabel('Quantity')\n\nplt.tight_layout()\nplt.savefig('../../reports/eda_distributions.png', dpi=150, bbox_inches='tight')\nplt.show()\nprint('Chart saved ✅')"]},
  {"cell_type":"markdown","metadata":{},"source":["## 3. Time Series Analysis"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["daily = df.groupby('Date')['TotalPrice'].sum().reset_index()\ndaily['Date'] = pd.to_datetime(daily['Date'])\ndaily = daily.sort_values('Date')\ndaily['MA7']  = daily['TotalPrice'].rolling(7).mean()\ndaily['MA30'] = daily['TotalPrice'].rolling(30).mean()\n\nfig, ax = plt.subplots(figsize=(15, 5))\nax.plot(daily['Date'], daily['TotalPrice'], alpha=0.4, color='#3b82f6', label='Daily Revenue')\nax.plot(daily['Date'], daily['MA7'],  color='#f59e0b', linewidth=2, label='7-day MA')\nax.plot(daily['Date'], daily['MA30'], color='#ef4444', linewidth=2, label='30-day MA')\nax.set_title('Daily Revenue with Moving Averages', fontsize=15)\nax.set_xlabel('Date')\nax.set_ylabel('Revenue (£)')\nax.legend()\nplt.tight_layout()\nplt.savefig('../../reports/eda_timeseries.png', dpi=150, bbox_inches='tight')\nplt.show()"]},
  {"cell_type":"markdown","metadata":{},"source":["## 4. Sales Heatmap – Day × Hour"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["heatmap = df.groupby(['DayOfWeek','Hour'])['TotalPrice'].sum().reset_index()\npivot = heatmap.pivot(index='DayOfWeek', columns='Hour', values='TotalPrice').fillna(0)\npivot.index = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun']\n\nfig, ax = plt.subplots(figsize=(15, 5))\nsns.heatmap(pivot, cmap='Blues', ax=ax, fmt='.0f', linewidths=0.5)\nax.set_title('Revenue Heatmap: Day of Week × Hour', fontsize=14)\nplt.tight_layout()\nplt.savefig('../../reports/eda_heatmap.png', dpi=150, bbox_inches='tight')\nplt.show()"]},
  {"cell_type":"markdown","metadata":{},"source":["## 5. Top Products & Countries"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n\ntop_products = df.groupby('Description')['TotalPrice'].sum().sort_values(ascending=False).head(15)\ntop_products.plot(kind='barh', ax=axes[0], color='#8b5cf6')\naxes[0].set_title('Top 15 Products by Revenue')\naxes[0].set_xlabel('Revenue (£)')\naxes[0].invert_yaxis()\n\ntop_countries = df.groupby('Country')['TotalPrice'].sum().sort_values(ascending=False).head(10)\ntop_countries.plot(kind='barh', ax=axes[1], color='#f59e0b')\naxes[1].set_title('Top 10 Countries by Revenue')\naxes[1].set_xlabel('Revenue (£)')\naxes[1].invert_yaxis()\n\nplt.tight_layout()\nplt.savefig('../../reports/eda_top_products_countries.png', dpi=150, bbox_inches='tight')\nplt.show()"]},
  {"cell_type":"markdown","metadata":{},"source":["## 6. Correlation Analysis"]},
  {"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["numeric_cols = ['Quantity','Price','TotalPrice','Month','DayOfWeek','Hour']\ncorr = df[numeric_cols].corr()\n\nfig, ax = plt.subplots(figsize=(8, 6))\nsns.heatmap(corr, annot=True, fmt='.2f', cmap='coolwarm', ax=ax, center=0)\nax.set_title('Correlation Heatmap', fontsize=14)\nplt.tight_layout()\nplt.savefig('../../reports/eda_correlation.png', dpi=150, bbox_inches='tight')\nplt.show()"]},
  {"cell_type":"markdown","metadata":{},"source":["## 7. Key Insights\n\n","- 📅 **Peak sales**: November–December (holiday season)\n","- 🕙 **Peak hours**: 10 AM – 2 PM on weekdays\n","- 🇬🇧 **UK dominates**: ~85% of revenue\n","- 📦 **Long tail**: Top 20 products account for ~40% of revenue\n","- ⚠️ **Outliers**: A few very large orders skew distributions\n"]}
